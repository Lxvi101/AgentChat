# ─── Convex ──────────────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment-id
VITE_CONVEX_URL=https://your-deployment-id.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-id.convex.site

# ─── Site / Auth ─────────────────────────────────────────────────────────────
# In production set these to https://agentch.at
VITE_SITE_URL=http://localhost:3000
VITE_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-secret-here

# ─── Redis (Upstash or any Redis instance) ───────────────────────────────────
REDIS_URL=rediss://default:your-password@your-host:6379

# ─── AI Provider API Keys ───────────────────────────────────────────────────
# You only need the keys for the providers you want to use.
# Recommended minimum for a "just works" setup: OPENAI + ANTHROPIC + GOOGLE.
# Add DEEPSEEK_API_KEY if you want the DeepSeek V4 Pro / V4 Flash models
# (1M context, thinking mode, served directly by DeepSeek's own API).
# Get one at https://platform.deepseek.com/api_keys
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
FIREWORK_API_KEY=
GROQ_API_KEY=
DEEPINFRA_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ─── Image Generation (Fal.ai) ──────────────────────────────────────────────
FAL_KEY=

# ─── Web Search (Firecrawl) ─────────────────────────────────────────────────
# Set FIRECRAWL_BASE_URL to your self-hosted Firecrawl instance or leave
# blank to use the default (https://api.firecrawl.dev).
FIRECRAWL_BASE_URL=
FIRECRAWL_USER=
FIRECRAWL_PASS=
SEARCH_API_KEY=

# ─── Auth Trusted Origins (comma-separated, for production deployments) ─────
# Used by Convex Better Auth to allow cross-origin requests.
# agentch.at and www.agentch.at are already trusted in code; add any extras here.
# Example: https://your-app.vercel.app,https://yourdomain.com
TRUSTED_ORIGINS=
